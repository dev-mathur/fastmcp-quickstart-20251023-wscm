---
import nav from '../data/nav.json';
import { site } from '../data/site';
import { getActiveTopics } from '../lib/books';
import { isCurrent, url } from '../lib/paths';

const topics = await getActiveTopics();
const pathname = Astro.url.pathname;
const onTopics = pathname.startsWith(url('/topics/'));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${site.name} home`}>
      <svg class="brand-mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <rect x="2" y="4" width="20" height="4.5" rx="2.25" fill="currentColor" />
        <rect x="2" y="10" width="15" height="4.5" rx="2.25" fill="currentColor" opacity=".8" />
        <rect x="2" y="16" width="10" height="4.5" rx="2.25" fill="currentColor" opacity=".6" />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="nav nav-desktop" aria-label="Primary">
      {nav.primary.slice(0, 1).map((item) => (
        <a href={url(item.href)} aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <details class="dropdown" data-dropdown>
        <summary aria-current={onTopics ? 'page' : undefined}>Topics</summary>
        <div class="panel">
          {topics.map((topic) => (
            <a href={url(`/topics/${topic.slug}/`)}>
              <span>{topic.name}</span>
              <span class="count">{topic.count}</span>
            </a>
          ))}
          <a class="panel-all" href={url('/topics/')}>All topics</a>
        </div>
      </details>
      {nav.primary.slice(1).map((item) => (
        <a href={url(item.href)} aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <span class="spacer"></span>

    <a class="icon-link" href={url('/search/')} aria-label="Search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </a>
    <a class="btn btn-primary btn-header" href={url(nav.cta.href)}>{nav.cta.label}</a>

    <details class="mobile-menu" data-dropdown>
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="panel">
        {nav.primary.map((item) => (
          <a href={url(item.href)}>{item.label}</a>
        ))}
        <a href={url('/search/')}>Search</a>
        <a href={url('/topics/')}>All topics</a>
        {topics.map((topic) => (
          <a class="panel-sub" href={url(`/topics/${topic.slug}/`)}>
            <span>{topic.name}</span>
            <span class="count">{topic.count}</span>
          </a>
        ))}
        <a class="panel-cta" href={url(nav.cta.href)}>{nav.cta.label}</a>
      </div>
    </details>
  </div>
</header>
