---
import Cover from './Cover.astro';
import { formatDate, readingMinutes, topicBySlug, type Book } from '../lib/books';
import { url } from '../lib/paths';

interface Props {
  book: Book;
  showTopic?: boolean;
}

const { book, showTopic = true } = Astro.props;
const { data } = book;
const topic = topicBySlug(data.topic);
const href = url(`/books/${book.id}/`);
const minutes = readingMinutes(book.body);
---

<article class="row">
  <div class="row-main">
    <h3 class="row-title"><a href={href}>{data.title}</a></h3>
    <p class="row-sub">{data.subtitle}</p>
    <div class="meta">
      {showTopic && topic && <a class="chip" href={url(`/topics/${topic.slug}/`)}>{topic.name}</a>}
      <span class="meta-strong">{data.book.title} by {data.book.author}</span>
      <span>{minutes} min read</span>
      <span>{formatDate(data.publishedAt)}</span>
      {data.sample && <span class="badge">Sample</span>}
    </div>
  </div>
  <a class="row-cover" href={href} tabindex="-1" aria-hidden="true">
    <Cover
      title={data.book.title}
      author={data.book.author}
      hue={topic?.hue ?? 212}
      slug={book.id}
      size="sm"
    />
  </a>
</article>
